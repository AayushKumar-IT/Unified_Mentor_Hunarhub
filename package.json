{
  "name": "hunarhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/index.js",
    "dev:web": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/src/index.js",
    "test": "node --test",
    "admin:create": "node backend/src/scripts/create-admin.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "file-type": "^22.2.0",
    "multer": "^2.5.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.4.5"
  }
}
